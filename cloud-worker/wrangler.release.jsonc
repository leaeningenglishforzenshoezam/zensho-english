{
  "name": "goimon-cloud-api-staging",
  "main": "src/mission_release.js",
  "compatibility_date": "2026-10-01",
  "vars": {
    "GOOGLE_CLIENT_ID": "860663516644-f7u8dqa2bdfemr0pnmcoi6j8v5oktslr.apps.googleusercontent.com",
    "ALLOWED_ORIGIN": "https://leaeningenglishforzenshoezam.github.io",
    "MISSION_RELEASE_ENABLED": "true",
    "ECONOMY_DRAW_ENABLED": "true",
    "ECONOMY_IMPORT_ENABLED": "true",
    "ECONOMY_AUTO_IMPORT_ENABLED": "true",
    "ECONOMY_LOADOUTS_ENABLED": "true",
    "ECONOMY_BONUS_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "goimon-cloud",
      "database_id": "d7c3db26-cc15-4215-ab55-6abcb4a2ab1e",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "preview_urls": false,
  "triggers": {
    "crons": [
      "17 * * * *"
    ]
  }
}

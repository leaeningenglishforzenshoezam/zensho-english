+const test=require('node:test'),assert=require('node:assert/strict'),fs=require('node:fs'),path=require('node:path'),vm=require('node:vm');
+const root=path.join(__dirname,'../dist');
+function fixture(){const data=new Map(),storage={getItem:k=>data.get(k)||null,setItem:(k,v)=>data.set(k,v)},c={localStorage:storage,GOIMONProfiles:{account:'guest'}};c.window=c;for(const file of ['battle-prototype/chapter1_data.js','battle-prototype/chapter_store.js','battle-prototype/chapter_staging.js','battle-prototype/chapter2_data.js','battle-prototype/chapter2_assets.js','battle-prototype/chapter2_progress.js','battle-prototype/chapter2_access.js','battle-prototype/chapter2_registry.js','quest_library.js'])vm.runInNewContext(fs.readFileSync(path.join(root,file),'utf8'),c,{filename:file});const d=c.GoimonChapter1Data,s={version:1,scriptVersion:d.scriptVersion,revision:0,scene:d.scenes.length-1,line:0,mode:'complete',completed:true,partnerId:'test',tutorial:{},read:[],cleared:[1,2,3,4,5,'mist']};return {c,data,storage,s,unlock(){storage.setItem('goimon_chapter1_v1:guest:lv1',JSON.stringify(s));}};}
+test('unlock requires completed Chapter 1; stage 5 and fog alone are insufficient',()=>{const f=fixture(),a=f.c.GoimonChapter2Access;assert.equal(a.current(),false);f.s.completed=false;f.s.mode='story';f.unlock();assert.equal(a.current(),false);f.s.completed=true;f.s.cleared=[5,'mist'];f.unlock();assert.equal(a.current(),false);f.s.cleared=[1,2,3,4,5,'mist'];f.unlock();assert.equal(a.current(),true);});
+test('completed chapter stays unlocked during replay; another account remains locked',()=>{const f=fixture();f.s.mode='story';f.s.scene=6;f.unlock();assert.equal(f.c.GoimonChapter2Access.current(),true);f.c.GOIMONProfiles.account='other';assert.equal(f.c.GoimonChapter2Access.current(),false);});
+test('corrupt first-chapter record stays untouched and locked',()=>{const f=fixture();f.storage.setItem('goimon_chapter1_v1:guest:lv1','broken');assert.equal(f.c.GoimonChapter2Access.current(),false);assert.equal(f.storage.getItem('goimon_chapter1_v1:guest:lv1'),'broken');});
+test('shared registry has two chapters and uses the correct progress loader',()=>{const f=fixture(),L=f.c.GoimonQuestLibrary;assert.equal(L.chapters.length,2);const ch=L.get('chapter2'),s=f.c.GoimonChapter2Progress.fresh(ch.data,{id:'test',type:'hirameki',stage:'child'});s.read=['ch2.01.001'];s.scene=1;s.line=0;f.storage.setItem(ch.key('guest'),JSON.stringify(s));const raw=f.storage.getItem(ch.key('guest'));assert.equal(L.load(ch,f.storage,'guest'),null);assert.equal(f.storage.getItem(ch.key('guest')),raw);f.unlock();assert.equal(L.load(ch,f.storage,'guest').scene,1);assert.equal(L.scenes(ch,s)[0].lines.length,1);assert.equal(L.scenes(ch,s)[1].lines.length,0);assert.equal(L.get('chapter1').data,f.c.GoimonChapter1Data);});
+test('dex unlocks only encountered characters, including exact boss introduction',()=>{const f=fixture(),L=f.c.GoimonQuestLibrary,ch=L.get('chapter2'),s=f.c.GoimonChapter2Progress.fresh(ch.data,{id:'test'});let entries=L.characters(ch,s);assert.equal(entries.filter(e=>e.unlocked).length,1);assert.equal(entries.find(e=>e.id==='saya').unlocked,false);s.scene=18;s.line=4;entries=L.characters(ch,s);assert.equal(entries.find(e=>e.battle===9).unlocked,false);s.line=5;entries=L.characters(ch,s);assert.equal(entries.find(e=>e.battle===9).unlocked,true);s.scene=22;s.line=14;s.read=ch.data.scenes.flatMap(s=>s.lines.map(l=>l.id));entries=L.characters(ch,s);assert.equal(entries.length,12);assert.equal(entries.filter(e=>e.unlocked).length,12);});
+test('pages load registry before shared hub and guard before chapter runtime',()=>{for(const page of ['quest_home.html','quest_records.html']){const html=fs.readFileSync(path.join(root,page),'utf8');assert.ok(html.indexOf('chapter2_registry.js')<html.indexOf('quest_library.js'));}const html=fs.readFileSync(path.join(root,'quest_chapter2.html'),'utf8');assert.ok(html.indexOf('chapter2_access.js')<html.indexOf('src="battle-prototype/chapter2.js"'));const entry=fs.readFileSync(path.join(root,'battle-prototype/chapter2_entry.js'),'utf8');assert.ok(!entry.includes('location.assign'));assert.ok(!entry.includes('qh-hero'));});

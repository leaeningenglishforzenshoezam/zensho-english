@@ -0,0 +1,25 @@
+/* Shared compact quiz chrome; setup pages and learning data are untouched. */
+#playBox.study-focus{scroll-margin-top:72px}
+#playBox.study-focus .study-focus-bar{display:flex;align-items:center;gap:8px;flex-wrap:wrap;margin-bottom:12px;position:relative}
+#playBox.study-focus .study-focus-count{font-size:14px;font-weight:750;color:#294c3d;margin-right:auto;white-space:nowrap}
+#playBox.study-focus .study-focus-bar button{width:auto!important;min-height:40px;padding:8px 12px;margin:0!important;font-size:14px;line-height:1.3;white-space:nowrap}
+#playBox.study-focus .study-focus-more{position:static;margin:0;padding:0;border:0;background:none}
+#playBox.study-focus .study-focus-more>summary{cursor:pointer;list-style:none;padding:10px 8px;font-size:13px;color:#365b49}
+#playBox.study-focus .study-focus-more>summary::-webkit-details-marker{display:none}
+#playBox.study-focus .study-focus-options{position:absolute;z-index:20;right:0;top:100%;width:min(280px,75vw);padding:16px;background:#fffdf4;color:#203a2d;border:1px solid #a9beaf;border-radius:12px;box-shadow:0 8px 24px #102c2426;display:flex;flex-wrap:wrap;gap:10px}
+#playBox.study-focus .study-focus-options>div{width:100%;font-size:13px!important;line-height:1.6;margin:0!important}
+#playBox.study-focus .study-focus-options button{white-space:normal}
+#playBox.study-focus .study-focus-empty,#playBox.study-focus .study-focus-duplicate{display:none!important}
+#playBox.study-focus>.hr{display:none}
+#playBox.study-focus .questionTopRow{margin-bottom:8px}
+#playBox.study-focus .study-focus-review{border:0;padding:0;background:none;margin:10px 0}
+#playBox.study-focus .study-focus-review>summary{display:none}
+#playBox.study-focus.study-focus-answered .study-focus-review>summary{display:list-item;cursor:pointer;padding:12px;border:1px solid #b7c9ba;border-radius:10px;color:#315940;background:#eff4ea;font-size:14px}
+#playBox.study-focus .study-focus-answer-tools{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px}
+#playBox.study-focus.study-focus-answered #questionLine,#playBox.study-focus.study-focus-answered #hintArea,#playBox.study-focus.study-focus-answered .study-focus-answer-tools{display:none!important}
+#playBox.study-focus #result,#playBox.study-focus #detail,#playBox.study-focus #feedbackBox{scroll-margin-top:12px}
+#playBox.study-focus #detail{line-height:1.7;color:#243b30}
+#playBox.study-focus #detail .detailBlock{margin-top:10px;padding:10px 12px}
+#playBox.study-focus #detail .detailLabel{margin-bottom:4px}
+#playBox.study-focus button:focus-visible,#playBox.study-focus summary:focus-visible{outline:3px solid #b78325;outline-offset:3px}
+@media(max-width:600px){#playBox.study-focus{padding:12px}#playBox.study-focus .study-focus-bar{gap:4px}#playBox.study-focus .study-focus-bar button{font-size:13px;padding:8px}#playBox.study-focus #detail{font-size:16px}#playBox.study-focus #result{margin-top:8px!important}}
diff --git a/dist/study_focus.js b/dist/study_focus.js
new file mode 100644
index 0000000..69c18e4
--- /dev/null
+++ b/dist/study_focus.js
@@ -0,0 +1,89 @@
+/* Presentation only: never changes answers, scoring, storage or quiz handlers. */
+(function () {
+  'use strict';
+  function counter(stats, progress, answered) {
+    const score = stats.match(/正解\s*(\d+)/)?.[1] || '0';
+    const current = (progress || stats).match(/第\s*(\d+)問\s*\/\s*(\d+)問/);
+    const session = stats.match(/今回：\s*(\d+)\s*\/\s*(\d+)/);
+    if (current) return `${current[1]} / ${current[2]}問 · 正解 ${score}`;
+    if (session) return `${Math.min(Number(session[2]), Number(session[1]) + (answered ? 0 : 1))} / ${session[2]}問 · 正解 ${score}`;
+    return '';
+  }
+  window.StudyFocus = { counter };
+  function mount() {
+    const box = document.getElementById('playBox');
+    if (!box || box.dataset.focusMounted) return;
+    box.dataset.focusMounted = '1';
+    box.classList.add('study-focus');
+    const find = id => box.querySelector('#' + id);
+    const stats = find('stats');
+    const progress = find('questionProgress') || find('questionNo');
+    const next = find('nextQTop') || find('nextBtn') || find('nextQ');
+    const results = ['result', 'detail', 'feedbackBox'].map(find).filter(Boolean);
+    const bank = find('chunkBank')?.parentElement;
+    const slots = find('answerSlots')?.parentElement;
+    const choices = bank || find('choices') || find('choicesBox');
+    const header = document.createElement('div'); header.className = 'study-focus-bar';
+    const count = document.createElement('span'); count.className = 'study-focus-count';
+    header.append(count);
+    const more = document.createElement('details'); more.className = 'study-focus-more';
+    const title = document.createElement('summary'); title.textContent = '詳細';
+    const content = document.createElement('div'); content.className = 'study-focus-options';
+    more.append(title, content); header.append(more); box.prepend(header);
+    [stats, progress, find('qMeta'), find('questionNoLine')].filter(Boolean).forEach(el => content.append(el));
+    ['backBtn', 'jumpIdiomBtn', 'jumpParaphraseBtn', 'manualWeakBtn', 'prevBtn'].map(find).filter(Boolean).forEach(el => content.append(el));
+    const audioQuiz = location.pathname.endsWith('audio_quiz.html');
+    if (!audioQuiz) {
+      const sound = find('speakQ') || find('speakBtn') || find('readBtn');
+      if (sound) {
+        const oldParent = sound.parentElement;
+        sound.classList.add('study-focus-sound'); header.append(sound);
+        if (oldParent !== box && oldParent.textContent.includes('※自動発音')) oldParent.classList.add('study-focus-empty');
+      }
+    }
+    if (next) { next.classList.add('study-focus-next'); header.append(next); }
+    // Remove only redundant navigation, retaining the existing button and its listeners.
+    const duplicate = next?.id === 'nextQTop' ? find('nextQ') : null;
+    if (duplicate) duplicate.classList.add('study-focus-duplicate');
+    box.querySelectorAll('.row, .questionNavRow').forEach(el => {
+      if (!el.textContent.trim()) el.classList.add('study-focus-empty');
+    });
+    let review = null;
+    if (bank && slots) {
+      review = document.createElement('details'); review.className = 'study-focus-review'; review.open = true;
+      const summary = document.createElement('summary'); summary.textContent = '自分の解答・語句カードを確認';
+      bank.before(review); review.append(summary, bank, slots);
+      const controls = document.createElement('div'); controls.className = 'study-focus-answer-tools';
+      ['hintBtn', 'resetBtn', 'checkBtn'].map(find).filter(Boolean).forEach(el => controls.append(el));
+      review.append(controls);
+    }
+    box.querySelectorAll('.row').forEach(el => { if (!el.textContent.trim()) el.classList.add('study-focus-empty'); });
+    const anchors = results.map(el => { const marker = document.createComment('feedback-position'); el.before(marker); return marker; });
+    let previous = false;
+    const update = () => {
+      // Feedback is empty on a fresh question. A validation warning is not an answer.
+      const ready = next ? !next.disabled && results.some(el => el.textContent.trim()) : !!find('feedbackBox') && !find('feedbackBox').classList.contains('hidden');
+      const value = counter(stats?.textContent || '', progress?.textContent || '', ready);

diff --git a/checks/idiom-replacement.test.cjs b/checks/idiom-replacement.test.cjs
new file mode 100644
index 0000000..e3db1bb
--- /dev/null
+++ b/checks/idiom-replacement.test.cjs
@@ -0,0 +1,23 @@
+const test = require('node:test');
+const assert = require('node:assert/strict');
+const fs = require('node:fs');
+const path = require('node:path');
+const vm = require('node:vm');
+test('IM123 replaces the bus pair without changing IDs or count', () => {
+  const ctx = { window: {} };
+  vm.createContext(ctx);
+  for (const file of ['idiom_data_1kyu.js', 'idiom_examples_1kyu.js']) {
+    const source = fs.readFileSync(path.join(__dirname, '../dist', file), 'utf8');
+    assert.doesNotMatch(source, /miss the bus|not make it to the bus/i);
+    vm.runInContext(source, ctx);
+  }
+  const data = ctx.window.IDIOM_DATA_1KYU;
+  assert.equal(data.length, 287);
+  assert.equal(new Set(data.map(x => x.id)).size, 287);
+  assert.equal(data.filter(x => x.expression === 'keep an eye on').length, 1);
+  const entry = data.find(x => x.id === 'IM123');
+  assert.equal(entry.expression, 'keep an eye on');
+  assert.equal(entry.paraphraseTo.join(), 'watch carefully');
+  assert.equal(entry.noteIds.length, 0);
+  assert.match(ctx.window.IDIOM_EXAMPLES_1KYU.IM123.exampleEn, /keep an eye on my bag/);
+});

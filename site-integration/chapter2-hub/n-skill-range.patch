diff --git a/checks/n-skill-range.test.cjs b/checks/n-skill-range.test.cjs
new file mode 100644
index 0000000..72e8fcf
--- /dev/null
+++ b/checks/n-skill-range.test.cjs
@@ -0,0 +1,3 @@
+const test=require('node:test'),assert=require('node:assert/strict'),C=require('../dist/battle-prototype/catalog.js'),E=require('../dist/battle-prototype/core.js');
+test('every N attack is 1.2–1.3 without an extra 10% multiplier',()=>{for(const s of C.skills.filter(x=>x.rarity==='N'&&x.type!=='heal')){assert.ok(s.power>=1.2&&s.power<=1.3,s.id);const p=E.actor({...C.species[0],id:'test',attr:s.attr,speed:999},1,{chie:0,kotoba:0,bunmyaku:0,onkan:0},null,[s]);const e={hp:99999,defense:20,attack:20,reference:20,attr:s.attr,speed:0};const expected=E.damage(p,e,s.power,1,s.attr);const b=E.create(p,e);E.resolve(b,'skill:0',true,{rng:()=>.5,elapsedMs:Infinity});assert.equal(99999-e.hp,expected,s.id);}});
+test('redesign notice does not reveal evolution motifs',()=>{const rows=require('../dist/announcements.json');const r=rows.find(x=>x.id==='goimon-redesign-preview-20261026');for(const phrase of ['カメレオン×怪盗','カエル×雷神','クラゲ×陰陽師'])assert.ok(!r.body.includes(phrase));});

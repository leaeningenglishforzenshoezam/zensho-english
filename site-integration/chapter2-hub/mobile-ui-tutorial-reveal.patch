+function ensure(){if(dialog)return;const template=document.createElement('template');template.innerHTML="<dialog id=\"reveal-dialog\" aria-labelledby=\"reveal-title\"><div class=\"reveal-scene\"><div class=\"reveal-rays\" aria-hidden=\"true\"></div><div class=\"reveal-stars\" aria-hidden=\"true\">✦　✧　✦<br>✧　　　✧<br>✦　✧　✦</div><button id=\"skip-effect\" class=\"skip\">結果へ</button><p class=\"eyebrow\" id=\"reveal-label\">NEW POWER</p><h2 id=\"reveal-title\">星の力が集まる…</h2><div id=\"reveal-art\"><img id=\"reveal-machine\" src=\"images/gacha/skill-machine.png\" alt=\"\"><button id=\"open-capsule\" hidden aria-label=\"カプセルを開く\"><span class=\"capsule\"></span></button></div><p id=\"reveal-hint\" aria-live=\"polite\"></p><div id=\"revealed-card\"></div><button id=\"reveal-next\" class=\"primary\" hidden>次へ</button></div></dialog>";document.body.append(template.content.cloneNode(true));dialog=$('reveal-dialog');bind();}

+const test=require('node:test');
+const assert=require('node:assert/strict');
+const fs=require('node:fs');
+const vm=require('node:vm');
+const path=require('node:path');
+const root=path.join(__dirname,'../dist');
+function run(host,search){
+ const sessionStorage={getItem:()=>JSON.stringify({token:'test',type:'hirameki',stage:'child',skills:['scream']})};
+ const localStorage={setItem(){throw Error('real save touched');}};
+ const ctx={window:{},location:{hostname:host,search},sessionStorage,localStorage,URLSearchParams,document:{addEventListener(){}}};
+ vm.runInNewContext(fs.readFileSync(path.join(root,'battle-prototype/developer_mode.js'),'utf8'),ctx);
+ return {api:ctx.window.GoimonDeveloper,sessionStorage,localStorage};
+}
+test('private preview developer uses isolated session storage',()=>{const x=run('terminal.local','?dev=1');assert.equal(x.api.active,true);assert.equal(x.api.storage,x.sessionStorage);assert.equal(x.api.keySuffix,':developer:test');assert.equal(x.api.pet.id,'developer-partner');});
+test('normal preview keeps normal records',()=>{const x=run('terminal.local','');assert.equal(x.api.active,false);assert.equal(x.api.storage,x.localStorage);assert.equal(x.api.keySuffix,'');});
+test('public GitHub host cannot enable developer mode',()=>{const x=run('leaeningenglishforzenshoezam.github.io','?dev=1');assert.equal(x.api.active,false);});
+test('announcements parse and no duplicate identifiers',()=>{const data=JSON.parse(fs.readFileSync(path.join(root,'announcements.json'),'utf8'));const rows=Array.isArray(data)?data:data.items||data.announcements;assert.ok(rows);assert.equal(new Set(rows.map(x=>x.id)).size,rows.length);});

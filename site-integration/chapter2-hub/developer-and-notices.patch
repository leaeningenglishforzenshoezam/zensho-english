diff --git a/dist/quest_developer.html b/dist/quest_developer.html
new file mode 100644
index 0000000..d2764df
--- /dev/null
+++ b/dist/quest_developer.html
@@ -0,0 +1 @@
+<!doctype html><html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>開発者用クエスト｜GOIMON</title><link rel="stylesheet" href="battle-prototype/chapter2.css"><script src="battle-prototype/catalog.js" defer></script><script src="battle-prototype/developer_mode.js" defer></script><script src="quest_developer.js" defer></script></head><body><header><a href="quest_home.html">‹ 通常のクエストメニュー</a></header><main><p class="eyebrow">DEVELOPER · TEMPORARY</p><h1>相棒と技を自由に試す</h1><p>所持していないゴイモン・技も試せます。通常の育成・所持品・学習記録・章の進行は変更しません。試遊の続きはこのタブだけに保存します。</p><section class="panel"><label>章<select id="dev-chapter"><option value="1">第1章 · ことばの森</option><option value="2">第2章 · ふたつの声</option></select></label><label>ゴイモン<select id="dev-species"></select></label><label>進化段階<select id="dev-stage"><option value="child">幼体</option><option value="growth">成長体</option><option value="mid">中級体</option><option value="final">上級体</option></select></label><div id="dev-skills"></div><p id="dev-error" role="alert"></p><button id="dev-start" class="primary">この編成で新しく試す</button></section></main></body></html>
diff --git a/dist/quest_developer.js b/dist/quest_developer.js
new file mode 100644
index 0000000..9325239
--- /dev/null
+++ b/dist/quest_developer.js
@@ -0,0 +1,5 @@
+(()=>{'use strict';const C=GoimonBattleCatalog,$=id=>document.getElementById(id);if(!GoimonDeveloper.allowed){$('dev-start').disabled=true;$('dev-error').textContent='確認用Site限定の機能です。';return;}
+function option(select,value,text){const o=document.createElement('option');o.value=value;o.textContent=text;select.append(o);}
+for(const s of C.species)option($('dev-species'),s.id,s.name);
+const selects=[];for(let i=0;i<4;i++){const label=document.createElement('label'),select=document.createElement('select');label.textContent='SKILL '+(i+1);select.id='dev-skill-'+i;option(select,'','セットしない');for(const s of C.skills)option(select,s.id,s.rarity+' '+s.name+' · '+(C.questionFormats[s.questionFormat]?.label||s.questionFormat));label.append(select);$('dev-skills').append(label);selects.push(select);}
+$('dev-start').onclick=()=>{const skills=selects.map(s=>s.value).filter(Boolean);if(new Set(skills).size!==skills.length){$('dev-error').textContent='同じ技は複数セットできません。';return;}sessionStorage.setItem('goimon_dev_config',JSON.stringify({type:$('dev-species').value,stage:$('dev-stage').value,skills,token:Date.now().toString(36)}));location.href='quest_chapter'+$('dev-chapter').value+'.html?dev=1';};})();
